# Managed by Terraform (modules/marketplace-vm); rewritten on every boot.
upstream marketplace_app {
    server 127.0.0.1:${app_port} fail_timeout=0;
}

upstream marketplace_frontend {
    server 127.0.0.1:${frontend_port} fail_timeout=0;
}

limit_req_zone $binary_remote_addr zone=marketplace_rl:10m rate=10r/s;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${server_name};

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 16m;

    location /api/ {
        limit_req zone=marketplace_rl burst=20 nodelay;
        proxy_pass http://marketplace_app;
        include /etc/nginx/proxy_params;
    }

    # Uploaded listing images are served by Flask.
    location /static/ {
        proxy_pass http://marketplace_app;
        include /etc/nginx/proxy_params;
    }

    # Everything else is the React SPA, which calls /api/ same-origin.
    location / {
        proxy_pass http://marketplace_frontend;
        include /etc/nginx/proxy_params;
    }
}
