# Managed by Terraform (modules/marketplace-vm); rewritten on every boot.
# Postgres and nginx run on the host; the app, the frontend and Redis are containers.
name: marketplace

services:
  app:
    image: ${app_image}
    restart: unless-stopped
    # app.env: secrets you fill in. db.env: DATABASE_URL written by the startup script.
    env_file:
      - app.env
      - db.env
    environment:
      APP_ENV: production
      REDIS_URL: redis://redis:6379/0
%{ if gunicorn_workers > 0 ~}
      GUNICORN_WORKERS: "${gunicorn_workers}"
%{ endif ~}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      # Loopback only: nginx on the host is the sole entry point.
      - "127.0.0.1:${app_port}:8000"
    volumes:
      - ./data/listing_images:/app/app/static/listing_images
    depends_on:
      redis:
        condition: service_healthy

  frontend:
    image: ${frontend_image}
    restart: unless-stopped
    ports:
      # Loopback only: nginx on the host routes / here and /api, /static to the app.
      - "127.0.0.1:${frontend_port}:80"

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  redis_data:
