# Flask API base URL. Leave empty to call the API same-origin (the dev server
# proxies /api and /static to VITE_DEV_PROXY_TARGET; in production put the SPA
# and the API behind the same host). Set it when the API lives on another
# origin - then add this app's origin to the backend's CORS_ORIGINS.
VITE_API_URL=

# Dev-only: where `npm run dev` proxies /api and /static (Flask runs on :4000
# in .vscode/launch.json).
VITE_DEV_PROXY_TARGET=http://localhost:4000
