# Dockerfile.ci - Optimized for the CI/CD pipeline
# Multi-stage build (Vite build -> nginx static serve)

# ============================================
# Stage 1: Build
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy manifests first for better layer cache utilisation
COPY package*.json ./

# Install exactly what the lockfile pins (dev deps included: the build runs tsc)
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm ci --no-audit --no-fund

# Copy source
COPY . .

# The shared pipeline (LiliHo-org/pipelines build_npm_docker.yml) injects REACT_APP_*
# build args. Vite only exposes VITE_*-prefixed vars through import.meta.env, so each
# value is re-exported below. Add new vars by following the same ARG -> ENV pattern.
ARG REACT_APP_BACKEND_URL
ARG REACT_APP_ENVIRONMENT=production
ARG REACT_APP_RELEASE_NUMBER
ARG REACT_APP_SENTRY_DSN
ARG REACT_APP_SENTRY

ENV VITE_API_URL=${REACT_APP_BACKEND_URL}
ENV VITE_ENVIRONMENT=${REACT_APP_ENVIRONMENT}
ENV VITE_RELEASE_NUMBER=${REACT_APP_RELEASE_NUMBER}
ENV VITE_SENTRY_DSN=${REACT_APP_SENTRY_DSN}
ENV VITE_SENTRY=${REACT_APP_SENTRY}

# An empty VITE_API_URL is valid: the SPA then calls the API same-origin.

# Typecheck + build (outputs to /app/dist)
RUN npm run build

# ============================================
# Stage 2: Production
# ============================================
FROM nginx:alpine AS production

# Custom nginx config (SPA routing, /healthCheck, caching)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/healthCheck || exit 1

CMD ["nginx", "-g", "daemon off;"]
