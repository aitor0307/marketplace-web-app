# Copy to .env and fill in real values. Never commit the real .env file.

# development | testing | production (falls back to FLASK_ENV, then development)
APP_ENV=development
FLASK_APP=wsgi.py

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
# Overrides the assembled URL above if set directly.
# DATABASE_URL=postgresql+psycopg2://marketplace:marketplace@localhost:5432/marketplace
# Production falls back to this when DATABASE_URL is unset:
# SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis (wired up, unused today; ready for caching/rate-limiting/vector search) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# --- Mail ----------------------------------------------------------------
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=1
# FILL IN: the Gmail account the app sends from, and its app password.
MAIL_USERNAME=
MAIL_PASSWORD=
# Account all user-facing mail (sign-up/approval notices, message alerts) is
# sent from. Empty = MAIL_USERNAME. With a username but no password it only
# changes From, which Gmail honours if it's a "Send mail as" alias of MAIL_USERNAME.
NOREPLY_MAIL_USERNAME=
NOREPLY_MAIL_PASSWORD=
ADMINS=

APP_HOST=http://localhost:5000

# React frontend (frontend/): base URL for links in emails, and the origins
# allowed to call /api/* from a browser (comma-separated).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Observability (docker-compose local stack) ---------------------------
STATSD_HOST=localhost

# --- Logging (app/utils/logger.py) ----------------------------------------
LOG_LEVEL=INFO
# Google Chat webhook LogRecordWrapper.notify() posts to; unset = no-op.
GCHAT_WEBHOOK=
# Sentry DSN for Logger.catch_exception(); unset = capture_exception() no-ops.
SENTRY_DSN=

# --- OAuth login (app/routes/operations/auth_ops.py) -----------------------
# The OAuth client ID registered with Google; required for /api/v1/auth/oauth/login
# with provider=google to verify a token's audience.
GOOGLE_OAUTH_CLIENT_ID=

# --- Registration approval (app/routes/operations/auth_ops.py) --------------
# Users who register with this key are active right away; everyone else is
# created "pending" (can't publish listings) and an approval link is emailed
# to REGISTRATION_APPROVER_EMAIL. Leave the key empty to require approval for all.
REGISTRATION_KEY=
# FILL IN: who receives approval requests. Empty = nobody is emailed.
REGISTRATION_APPROVER_EMAIL=
# Who pending users are told to contact (sign-up popup + email). Empty = the approver.
REGISTRATION_CONTACT_EMAIL=
# --- Feedback (app/routes/operations/feedback_ops.py) ------------------------
# Where users' bug reports and improvement ideas are emailed. Empty = the approver.
FEEDBACK_EMAIL=
