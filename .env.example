# Copy to .env and fill in real values. Never commit the real .env file.

# development | testing | production (falls back to FLASK_ENV, then development)
APP_ENV=development
FLASK_APP=wsgi.py

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
# Overrides the assembled URL above if set directly.
# DATABASE_URL=postgresql+psycopg2://marketplace:marketplace@localhost:5432/marketplace

# --- Redis (wired up, unused today; ready for caching/rate-limiting/vector search) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# --- Mail ----------------------------------------------------------------
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
ADMINS=

APP_HOST=http://localhost:5000

# --- Observability (docker-compose local stack) ---------------------------
STATSD_HOST=localhost
